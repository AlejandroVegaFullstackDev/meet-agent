<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetAgent.Desktop.ViewModels"
             x:Class="MeetAgent.Desktop.Views.RecordView"
             x:DataType="vm:MainViewModel">

  <DockPanel Margin="20">
    <!-- Barra superior: estado + botón -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{DynamicResource InkFaintBrush}" />
          <TextBlock Text="{Binding StatusText}" Classes="heading-sm" />
          <TextBlock Text="{Binding Elapsed}" Classes="timestamp" VerticalAlignment="Center"
                     IsVisible="{Binding IsRunning}" />
        </StackPanel>
        <TextBlock Text="{Binding TranscriberName, StringFormat='Transcriptor: {0}'}" Classes="caption"
                   Foreground="{DynamicResource InkMutedBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding ToggleCommand}" Content="{Binding SidebarActionText}"
              MinWidth="120" Classes.primary="{Binding !IsRunning}" Classes.danger="{Binding IsRunning}"
              VerticalAlignment="Center" />
    </Grid>

    <!-- Bot de Meet (Vexa autohospedado): pegar link → Unir bot -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12" IsVisible="{Binding CanUseBot}">
      <TextBox Text="{Binding MeetLink}" Watermark="Pega el link de Google Meet para que entre el bot (meet.google.com/…)"
               IsEnabled="{Binding !IsBotRunning}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Unir bot" Command="{Binding JoinBotCommand}" Classes="secondary sm"
              Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="Sacar bot" Command="{Binding LeaveBotCommand}" Classes="secondary sm"
              Margin="8,0,0,0" IsVisible="{Binding IsBotRunning}" />
    </Grid>

    <!-- Pie: último mensaje -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LastLog}" Classes="caption" Margin="0,10,0,0"
               Foreground="{DynamicResource InkMutedBrush}" TextTrimming="CharacterEllipsis" />

    <!-- Transcripción en vivo -->
    <Border Classes="card">
      <Grid>
        <TextBlock Text="Pulsa Grabar para transcribir tu próxima reunión."
                   Classes="body" Foreground="{DynamicResource InkMutedBrush}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                   IsVisible="{Binding !SegmentCount}" />
        <ScrollViewer x:Name="TranscriptScroll" Padding="14,10">
          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}" />
        </ScrollViewer>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
