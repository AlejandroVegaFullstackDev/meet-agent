<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetAgent.Desktop.ViewModels"
             x:Class="MeetAgent.Desktop.Views.RecordView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <!-- Estado: reposo o reunión en curso -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsRunning}">
          <Border Classes="badge live">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Grid Width="12" Height="12" VerticalAlignment="Center">
                <Ellipse Classes="pulse" Fill="{DynamicResource LiveBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding StatusText}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Elapsed}" Classes="timer" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Grabar" Classes="display" IsVisible="{Binding !IsRunning}" />
        <TextBlock Text="Escuchando…" Classes="body-sm" Foreground="{DynamicResource InkMutedBrush}"
                   IsVisible="{Binding IsRunning}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Terminar" Command="{Binding ToggleCommand}" Classes="danger"
              IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
    </Grid>

    <!-- Bot de Meet (Vexa autohospedado): pegar link → Unir bot -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12" IsVisible="{Binding CanUseBot}">
      <TextBox Text="{Binding MeetLink}" PlaceholderText="Pega el link de Google Meet para que entre el bot"
               IsEnabled="{Binding !IsBotRunning}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Unir bot" Command="{Binding JoinBotCommand}" Classes="secondary sm"
              Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="Sacar bot" Command="{Binding LeaveBotCommand}" Classes="secondary sm"
              Margin="8,0,0,0" IsVisible="{Binding IsBotRunning}" />
    </Grid>

    <!-- Reposo: estado vacío + última reunión -->
    <Grid Grid.Row="2" RowDefinitions="*,Auto" IsVisible="{Binding !IsRunning}">
      <Border Classes="card">
        <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
          <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                  Background="{DynamicResource BrandSubtleBrush}">
            <PathIcon Data="{StaticResource IconMic}" Width="24" Height="24"
                      Foreground="{DynamicResource BrandBrush}" />
          </Border>
          <TextBlock Text="Pulsa Grabar para transcribir tu próxima reunión." Classes="heading-sm"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="Funciona con Meet, Zoom, Teams o cualquier llamada." Classes="body"
                     Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Content="Grabar" Command="{Binding ToggleCommand}" Classes="primary lg"
                  MinWidth="160" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Margin="0,12,0,0" IsVisible="{Binding HasLastMeeting}">
        <Grid ColumnDefinitions="*,Auto" Margin="16">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="ÚLTIMA REUNIÓN" Classes="section" />
            <TextBlock Text="{Binding LastMeeting.Title}" Classes="body-strong" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption" Foreground="{DynamicResource InkMutedBrush}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} · {1}">
                  <Binding Path="LastMeeting.When" /><Binding Path="LastMeeting.Duration" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <Button Grid.Column="1" Content="Ver en el historial" Command="{Binding ShowHistoryCommand}"
                  Classes="secondary sm" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <!-- Grabando: transcripción en vivo -->
    <Border Grid.Row="2" Classes="card" IsVisible="{Binding IsRunning}">
      <Grid>
        <TextBlock Text="Escuchando…" Classes="body" Foreground="{DynamicResource InkMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !SegmentCount}" />
        <ScrollViewer x:Name="TranscriptScroll" Padding="14,10">
          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Último mensaje: qué pasó, sin jerga -->
    <TextBlock Grid.Row="3" Text="{Binding LastLog}" Classes="caption" Margin="0,10,0,0"
               Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
               IsVisible="{Binding LastLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
