<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeetAgent.Desktop.ViewModels"
             xmlns:ai="using:MeetAgent.Ai"
             x:Class="MeetAgent.Desktop.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12" MaxWidth="660" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="Conecta tu IA" Classes="display" />
        <TextBlock Text="MeetAgent analiza tus reuniones con la IA que ya usas. Elige una opción:"
                   Classes="body" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProviderCardViewModel">
            <Border Classes="card" Padding="14" Margin="0,0,0,8">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{Binding BrandBrushKey, Converter={StaticResource BrushKey}}"
                            IsVisible="{Binding ShowsBrandLogo}">
                      <TextBlock Text="{Binding LogoText}" FontSize="11" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{Binding LogoInkBrushKey, Converter={StaticResource BrushKey}}" />
                    </Border>
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            IsVisible="{Binding !ShowsBrandLogo}">
                      <Panel>
                        <PathIcon Data="{StaticResource IconKey}" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{DynamicResource BrandBrush}"
                                  IsVisible="{Binding IsApiKey}" />
                        <PathIcon Data="{StaticResource IconMonitor}" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{DynamicResource BrandBrush}"
                                  IsVisible="{Binding IsOwnModel}" />
                      </Panel>
                    </Border>
                  </Panel>

                  <StackPanel Grid.Column="1" Spacing="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="heading-sm" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" Classes="body-sm"
                               Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap"
                               Foreground="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding ShowConnectedStatus}" />
                    <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap"
                               Foreground="{DynamicResource LiveBrush}"
                               IsVisible="{Binding ShowErrorStatus}" />
                    <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap"
                               Foreground="{DynamicResource InkMutedBrush}"
                               IsVisible="{Binding ShowProgressStatus}" />
                    <Path Data="M12 2a10 10 0 1 1-7.07 2.93" Classes="spinner"
                          Stroke="{DynamicResource BrandBrush}" StrokeThickness="2" StrokeLineCap="Round"
                          Margin="0,5,0,0" HorizontalAlignment="Left" IsVisible="{Binding IsBusy}">
                      <Path.RenderTransform>
                        <RotateTransform Angle="0" />
                      </Path.RenderTransform>
                    </Path>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                              VerticalAlignment="Center">
                    <Border Classes="badge success" IsVisible="{Binding IsConnected}">
                      <TextBlock Text="Conectado ✓" />
                    </Border>
                    <Button Content="Desconectar" Command="{Binding DisconnectCommand}"
                            Classes="ghost sm" IsVisible="{Binding IsConnected}" />
                    <Button Content="{Binding ActionLabel}" Command="{Binding ConnectCommand}"
                            Classes="secondary sm" IsVisible="{Binding !IsConnected}" />
                  </StackPanel>
                </Grid>

                <!-- DeepSeek y Google sin Node: solo la key, sin componentes. -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowsKeyField}">
                  <TextBox Text="{Binding KeyValue}" PasswordChar="•"
                           PlaceholderText="Pega tu API key" />
                  <TextBlock Text="{Binding KeyStatus}" Classes="caption"
                             Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                             IsVisible="{Binding HasKeyStatus}" />
                </StackPanel>

                <!-- Si la instalación falla, se puede seguir con una key. -->
                <Button Content="Usar una API key" Command="{Binding UseApiKeyCommand}"
                        Classes="ghost sm" HorizontalAlignment="Left"
                        IsVisible="{Binding ShowKeyAlternative}" />

                <!-- «Tengo una API key» -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowApiKeyForm}">
                  <ListBox ItemsSource="{Binding ApiProviders}" SelectedItem="{Binding SelectedProvider}"
                           Classes="chips">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="ai:ProviderInfo">
                        <TextBlock Text="{Binding ShortLabel}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="{Binding ApiKeyHint}" />
                    <Button Grid.Column="1" Content="Conseguir key" Command="{Binding OpenSelectedKeyPageCommand}"
                            Classes="ghost sm" Margin="8,0,0,0" />
                  </Grid>
                  <Button Content="Avanzado" Command="{Binding ToggleAdvancedCommand}"
                          Classes="ghost sm" HorizontalAlignment="Left" />
                  <StackPanel Spacing="8" IsVisible="{Binding ShowAdvanced}">
                    <TextBox Text="{Binding Model}" PlaceholderText="Modelo" />
                    <TextBox Text="{Binding ApiBaseUrl}" PlaceholderText="{Binding BaseUrlHint}" />
                  </StackPanel>
                </StackPanel>

                <!-- «Tengo mi propio modelo» -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowOwnModelForm}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding OwnBaseUrl}" PlaceholderText="Dirección (http://localhost:11434/v1)" />
                    <Button Grid.Column="1" Content="Buscar modelos" Command="{Binding DetectModelsCommand}"
                            Classes="secondary sm" Margin="8,0,0,0" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding OwnModel}"
                            PlaceholderText="Modelos encontrados" HorizontalAlignment="Stretch" />
                  <TextBox Text="{Binding OwnModel}" PlaceholderText="Nombre del modelo" />
                  <TextBox Text="{Binding OwnKey}" PasswordChar="•" PlaceholderText="API key (si tu servidor la pide)" />
                  <TextBlock Text="{Binding ModelsStatus}" Classes="caption"
                             Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
                             IsVisible="{Binding HasModelsStatus}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Transcripción: sin ella se puede analizar, pero no transcribir llamadas. -->
      <Border Classes="card" Padding="16" IsVisible="{Binding ShowGroqNote}">
        <StackPanel Spacing="8">
          <TextBlock Text="Para grabar llamadas con audio, conecta también un transcriptor. Groq es gratis."
                     Classes="body-sm" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Conectar Groq" Command="{Binding ConnectGroqCommand}" Classes="secondary sm" />
            <Button Content="Crear key" Command="{Binding OpenGroqKeysCommand}" Classes="ghost sm" />
          </StackPanel>
          <TextBox Text="{Binding GroqKey}" PasswordChar="•" PlaceholderText="API key de Groq"
                   IsVisible="{Binding IsGroqFormVisible}" />
          <TextBlock Text="{Binding GroqStatus}" Classes="caption"
                     Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding GroqStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <TextBlock Text="Pulsa Grabar para transcribir tu próxima reunión. Funciona con Meet, Zoom, Teams o cualquier llamada."
                   Classes="body-sm" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
                   VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Content="Empezar a grabar" Command="{Binding StartRecordingCommand}"
                Classes="primary lg" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
