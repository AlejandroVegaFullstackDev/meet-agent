<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeetAgent.Desktop.ViewModels"
        x:Class="MeetAgent.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MeetAgent"
        Width="760" Height="560" MinWidth="460" MinHeight="360"
        Background="{DynamicResource SurfaceBrush}">

  <DockPanel Margin="16">
    <!-- Barra superior: estado + botón -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{DynamicResource IdleBrush}" />
          <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Elapsed}" Classes="mono muted" VerticalAlignment="Center"
                     IsVisible="{Binding IsRunning}" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="12">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}Transcriptor: {0} · {1}">
              <Binding Path="TranscriberName" />
              <Binding Path="DiskText" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="1" x:Name="ToggleButton" Command="{Binding ToggleCommand}"
              Content="{Binding ButtonText}" MinWidth="120" Padding="18,8"
              HorizontalContentAlignment="Center" VerticalAlignment="Center"
              Classes.accent="{Binding !IsRunning}" />
    </Grid>

    <!-- Pie: último mensaje -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding LastLog}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="muted" FontSize="12"
                 Text="{Binding SegmentCount, StringFormat='{}{0} segmentos'}" />
    </Grid>

    <!-- Transcripción en vivo -->
    <Border Classes="card">
      <Grid>
        <TextBlock Text="Pulsa «Empezar» para transcribir tu reunión. Antes te preguntaré si quieres grabar el audio."
                   Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                   IsVisible="{Binding !SegmentCount}" />
        <ScrollViewer x:Name="TranscriptScroll" Padding="14,10">
          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TranscriptLine">
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4">
                  <TextBlock Text="{Binding Time, StringFormat='[{0}]'}" Classes="mono muted"
                             VerticalAlignment="Top" Margin="0,3,10,0" />
                  <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Margin="0,1,10,0"
                          VerticalAlignment="Top" MinWidth="48"
                          Classes.yo="{Binding IsMe}" Classes.otros="{Binding !IsMe}">
                    <TextBlock Text="{Binding SpeakerLabel}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                  </Border>
                  <SelectableTextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </DockPanel>

  <Window.Styles>
    <Style Selector="Border.yo">
      <Setter Property="Background" Value="{DynamicResource YoSoftBrush}" />
    </Style>
    <Style Selector="Border.yo > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource YoBrush}" />
    </Style>
    <Style Selector="Border.otros">
      <Setter Property="Background" Value="{DynamicResource OtrosSoftBrush}" />
    </Style>
    <Style Selector="Border.otros > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OtrosBrush}" />
    </Style>
  </Window.Styles>
</Window>
