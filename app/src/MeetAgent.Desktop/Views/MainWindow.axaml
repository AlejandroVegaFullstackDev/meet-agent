<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeetAgent.Desktop.ViewModels"
        x:Class="MeetAgent.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MeetAgent"
        Width="900" Height="600" MinWidth="520" MinHeight="380"
        Background="{DynamicResource SurfaceBrush}">

  <!-- Shell: barra lateral de 200 px (rail de 48 px si la ventana baja de 680 px) + página actual. -->
  <Grid ColumnDefinitions="Auto,*">
    <Border Classes="sidebar" Width="{Binding SidebarWidth}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                    Margin="0,16,0,20" HorizontalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrandBrush}">
            <PathIcon Data="{StaticResource IconSparkle}" Width="14" Height="14"
                      Foreground="{DynamicResource OnBrandBrush}" />
          </Border>
          <TextBlock Text="MeetAgent" Classes="body-strong" VerticalAlignment="Center"
                     IsVisible="{Binding !IsRail}" />
        </StackPanel>

        <Button DockPanel.Dock="Top" Command="{Binding ToggleCommand}"
                Classes="action" Classes.rail="{Binding IsRail}"
                Classes.primary="{Binding !IsRunning}" Classes.danger="{Binding IsRunning}"
                ToolTip.Tip="{Binding SidebarActionText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconMic}" Width="16" Height="16" IsVisible="{Binding !IsRunning}" />
            <PathIcon Data="{StaticResource IconStop}" Width="16" Height="16" IsVisible="{Binding IsRunning}" />
            <TextBlock Text="{Binding SidebarActionText}" VerticalAlignment="Center" IsVisible="{Binding !IsRail}" />
          </StackPanel>
        </Button>

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="8,0">
          <Button Classes="nav" Classes.rail="{Binding IsRail}" Classes.active="{Binding IsHistoryPage}"
                  Command="{Binding ShowHistoryCommand}" ToolTip.Tip="Historial">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16" />
              <TextBlock Text="Historial" VerticalAlignment="Center" IsVisible="{Binding !IsRail}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="8,8">
          <Button Classes="nav" Classes.rail="{Binding IsRail}" Classes.active="{Binding IsConnectPage}"
                  Command="{Binding ShowConnectCommand}" ToolTip.Tip="{Binding IaStatusText}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconSparkle}" Width="16" Height="16" />
              <TextBlock Text="{Binding IaStatusText}" VerticalAlignment="Center" IsVisible="{Binding !IsRail}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.rail="{Binding IsRail}" Classes.active="{Binding IsSettingsPage}"
                  Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Ajustes">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
              <TextBlock Text="Ajustes" VerticalAlignment="Center" IsVisible="{Binding !IsRail}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding Page}" />
  </Grid>
</Window>
