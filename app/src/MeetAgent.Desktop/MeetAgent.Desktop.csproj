<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <AssemblyName>MeetAgent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetAgent.Core\MeetAgent.Core.csproj" />
    <ProjectReference Include="..\MeetAgent.Audio.Linux\MeetAgent.Audio.Linux.csproj" />
    <ProjectReference Include="..\MeetAgent.Audio.Windows\MeetAgent.Audio.Windows.csproj" />
    <ProjectReference Include="..\MeetAgent.Stt.Whisper\MeetAgent.Stt.Whisper.csproj" />
    <ProjectReference Include="..\MeetAgent.Storage.Sqlite\MeetAgent.Storage.Sqlite.csproj" />
  </ItemGroup>

</Project>
