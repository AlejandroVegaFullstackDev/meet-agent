{
  "manifest_version": 3,
  "name": "MeetAgent — notas de Meet",
  "short_name": "MeetAgent",
  "version": "0.3.1",
  "description": "Lee los subtítulos de Google Meet (con el nombre de cada persona) y los guarda en MeetAgent, en tu equipo. Sin bot, sin nube.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "mic-mixer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "selectors.js",
        "assembler.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "meetagent@alejandrovega.dev",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "MeetAgent · Historial",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
